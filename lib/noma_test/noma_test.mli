(** ミドルウェアの契約検査器。

    ミドルウェアの契約は noma で最も重要で、同時に最も破られやすい。だから契約を
    文章で書くだけにせず、{b 実行できる検査器}として出荷する。自作のミドルウェアを
    持つ人は、自分のテストスイートから {!check_middleware} を呼べばよい。

    {[
      let () =
        Alcotest.run "my-app"
          [ ("契約", [ ("my_mw", `Quick, fun () -> Noma_test.check_middleware My.mw) ]) ]
    ]}

    {2 何を検査し、何を検査しないか}

    検査するのは{b 機械的に判定できる契約だけ}である。「下流の status を理由なく
    変えない」という契約も文書には書いてあるが、[recover] の 例外→500 や
    [timeout] の →503 は正当な変更であり、検査器には正当な変更と事故を区別する
    手立てがない。{b 区別できないものを載せると、正しいミドルウェアが落ちて
    検査器が信用を失う}ので載せない。

    {2 Eio の資源を要するミドルウェア}

    検査器そのものはスケジューラを必要としない。ただし [timeout] のように
    Eio の能力 (clock など) を使うミドルウェアを検査するときは、呼び出し側を
    [Eio_main.run] で包むこと。 *)

exception Contract_violation of string
(** 契約違反。どの契約 (M1–M5) をどう破ったかを文面に含む。 *)

val check_middleware : ?name:string -> Noma.middleware -> unit
(** [check_middleware mw] は [mw] を探針にかけ、契約 M1–M5 を検査する。

    要求: [mw] は同じ入力に対して繰り返し呼べること — 検査器は [mw] を複数回
          適用する。初期化を伴うミドルウェアは [mw ()] のように適用済みの
          値を渡すこと。
    保証: 違反が 1 つでもあれば {!Contract_violation} を送出し、文面に [name] と
          破られた契約の番号を含める。何も送出しなければ以下がすべて成り立つ:

          - {b M1} [inner] の呼び出し回数は 0 回か 1 回 (正常・例外・abort の
            いずれの経路でも)。
          - {b M2} [inner] を呼んだ場合、[Noma.Aborted] と
            [Eio.Cancel.Cancelled] を素通しする。[inner] を呼ばずに短絡する
            ミドルウェア (preflight 応答など) は素通しすべき例外を持たないので
            問われない。
          - {b M3} 正常な [inner] に対して例外を投げない。
          - {b M4} [Request.ctx] の既存の束縛を消さない。
          - {b M5} 返した [Response] の本体が読める (下流の本体を読み捨てて
            いない)。

          これらは必要条件であって十分条件ではない。検査を通ったからといって
          ミドルウェアが正しいことにはならない。 *)

val probe_request : unit -> Noma.Request.t
(** 検査器が使うのと同じ、何の変哲もない [GET /] のリクエスト。

    保証: 文脈は空で、本体も空。自前の探針を書くときの出発点に使える。 *)
