# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A small, direct-style HTTP library for OCaml 5"
description: """
noma treats an HTTP request as a value and a server as a function that maps
it to a response. Handlers are `Request.t -> Response.t`; middleware is
`handler -> handler`. No monad, no callback, no `next`. The core knows
nothing about sockets - wire protocols live in adapter packages."""
maintainer: ["taison tsukada"]
authors: ["taison tsukada"]
license: "MIT"
tags: ["http" "web" "eio" "effects"]
homepage: "https://github.com/taison-tsukada/noma"
bug-reports: "https://github.com/taison-tsukada/noma/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.1.0"}
  "http" {>= "6.0.0"}
  "hmap" {>= "0.8.1"}
  "uri" {>= "4.2.0"}
  "eio" {>= "1.0"}
  "logs" {>= "0.7.0"}
  "routes" {>= "2.0.0"}
  "mtime" {>= "2.0.0"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/taison-tsukada/noma.git"
x-maintenance-intent: ["(latest)"]
