# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Yojson helpers for noma"
description: """
Optional convenience layer binding Yojson to noma's string-based JSON
constructors. noma core deliberately does not choose a JSON library."""
maintainer: ["taison tsukada"]
authors: ["taison tsukada"]
license: "MIT"
tags: ["http" "web" "json"]
homepage: "https://github.com/taison-tsukada/noma"
bug-reports: "https://github.com/taison-tsukada/noma/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.1.0"}
  "noma" {= version}
  "yojson" {>= "2.0.0"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/taison-tsukada/noma.git"
x-maintenance-intent: ["(latest)"]
