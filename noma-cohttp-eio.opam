# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "cohttp-eio adapter for noma"
description: """
Binds a noma handler to a socket using cohttp-eio. Implements the noma
adapter contract (A1-A6): per-request effect handler and switch, bounded
request head, keep-alive body drain-or-close, RFC-correct framing."""
maintainer: ["taison tsukada"]
authors: ["taison tsukada"]
license: "MIT"
tags: ["http" "web" "eio"]
homepage: "https://github.com/taison-tsukada/noma"
bug-reports: "https://github.com/taison-tsukada/noma/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.1.0"}
  "noma" {= version}
  "cohttp-eio" {>= "6.0.0"}
  "eio_main" {>= "1.2"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/taison-tsukada/noma.git"
x-maintenance-intent: ["(latest)"]
